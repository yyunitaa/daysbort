# Used by refresh/pull scripts (scripts/export-data.mjs, scripts/pull-followers.mjs,
# which need the l1_silver/l2_gold warehouse) AND by the login/org/figure/member
# system (app/api/*, tables in the `public` schema — run `npm run migrate` once).
#
# Local dev: fill in DB_HOST etc. below (plain Postgres, no SSL).
# Production (Vercel): set DATABASE_URL instead (e.g. Supabase's connection
# string, Settings → Database → Connection string → URI) — lib/db.js and
# scripts/migrate.mjs both prefer it over DB_HOST when set, and connect with
# SSL automatically. The l1_silver/l2_gold warehouse does NOT need to exist in
# that DB — the deployed dashboard only reads the committed data/*.js
# snapshots, never queries the warehouse at runtime. Only the `public` schema
# (created by `npm run migrate`) needs to exist there.
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kanalytics_spi_test
DB_USER=postgres
DB_PASSWORD=postgres

# Used to sign the login session cookie (app/api/auth/*, lib/auth.js).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production than local dev.
SESSION_SECRET=

# Used only by scripts/pull-followers.mjs (npm run pull-followers -- --yes).
# SPENDS REAL MONEY when used — see that script's header comment.
APIFY_TOKEN=
